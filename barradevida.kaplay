{"name":"Project #1 ","version":"2.0.0","files":[["main.js",{"path":"main.js","kind":"main","value":"//Flechas arriba y abajo para actualizar los valores de la barra\nkaplay({\n    background: [30, 30, 50],\n});\n\nlet vida = 100;\n\nconst marco = add([\n    rect(104, 24),\n    pos(center()),\n    anchor(\"center\"),\n    outline(2, rgb(255, 255, 255)),\n]);\n\nconst barra = add([\n    rect(vida, 20),\n    pos(marco.pos),\n    anchor(\"left\"),\n    color(255, 0, 0),\n]);\n\nbarra.pos.x = barra.pos.x - (marco.width / 2) + 2;\nbarra.pos.y = barra.pos.y;\n\nonUpdate(() => {\n    barra.width = vida;\n});\n\nonKeyPress(\"up\", () => {\n    vida = Math.min(100, vida + 10);\n});\n\nonKeyPress(\"down\", () => {\n    vida = Math.max(0, vida - 10);\n});","language":"javascript"}],["assets.js",{"path":"assets.js","kind":"assets","value":"loadSprite(\"mark\", \"assets/sprites/mark.png\");\nloadHappy();\n","language":"javascript"}],["kaplay.js",{"path":"kaplay.js","kind":"kaplay","value":"kaplay({\n    focus: false,\n    font: \"happy\",\n    background: \"#4a3052\", \n});\n","language":"javascript"}],["scenes/game.js",{"path":"scenes/game.js","kind":"scene","value":"import { addWelcomeText } from \"../objects/welcomeText.js\";\n\nscene(\"game\", () => {\n    addWelcomeText();\n\n    add([\n        sprite(\"mark\"),\n        pos(center()),\n        scale(2),\n        anchor(\"center\"),\n        rotate(0),\n    ]);\n});","language":"javascript"}],["objects/welcomeText.js",{"path":"objects/welcomeText.js","kind":"obj","value":"export function addWelcomeText() {\n    const txt = add([\n        text(\"Welcome to\\n KAPLAYGROUND\\n 2.4.0\", { align: \"center\" }),\n        pos(center().add(0, -130)),\n        anchor(\"center\"),\n    ]);\n\n    return txt;\n}\n","language":"javascript"}]],"assets":[["assets/sprites/mark.png",{"name":"mark.png","path":"assets/sprites/mark.png","url":"data:image/png;base64,","kind":"sprite","importFunction":"loadSprite(\"mark\", \"assets/sprites/mark.png\");"}],["assets/sounds/mark_voice.wav",{"name":"mark_voice.wav","path":"assets/sounds/mark_voice.wav","url":"data:audio/wave;base64,","kind":"sound","importFunction":"loadSound(\"mark_voice\", \"assets/sounds/mark_voice.wav\");"}]],"mode":"pj","buildMode":"esbuild","kaplayVersion":"4000.0.0-alpha.21","createdAt":"2025-08-27T13:40:59.682Z","updatedAt":"2025-08-27T13:56:31.893Z","favicon":""}
{"name":"Example #3 ","version":"2.0.0","files":[["main.js",{"kind":"main","language":"javascript","name":"main.js","path":"main.js","value":"kaplay();\n\nloadSprite(\"bean\", \"/sprites/bean.png\");\nloadSprite(\"coin\", \"/sprites/coin.png\");\nloadSprite(\"spike\", \"/sprites/spike.png\");\nloadSprite(\"grass\", \"/sprites/grass.png\");\nloadSprite(\"ghosty\", \"/sprites/ghosty.png\");\nloadSprite(\"door\", \"/sprites/door.png\");\nloadSound(\"score\", \"/sounds/score.mp3\");\n\nconst SPEED = 480;\nsetGravity(2400);\n\nlet score = 0;\nlet lives = 3;\nlet timeLeft = 60;\n\n// --- HUD arriba fijo ---\nconst hud = add([\n    pos(24, 24),\n    fixed(),\n]);\n\nconst livesLabel = hud.add([\n    text(\"❤️ \" + lives, { size: 32 }),\n    pos(0, 0),\n]);\n\nconst scoreLabel = hud.add([\n    text(\"💰 \" + score, { size: 32 }),\n    pos(200, 0),\n]);\n\nconst timerLabel = hud.add([\n    text(\"⏱️ \" + timeLeft, { size: 32 }),\n    pos(width() - 250, 0),\n    fixed(),\n]);\n\nloop(1, () => {\n    timeLeft -= 1;\n    timerLabel.text = \"⏱️ \" + timeLeft;\n    if (timeLeft <= 0) {\n        go(\"gameover\", { score });\n    }\n});\n\n// --- Nivel más largo ---\nconst level = addLevel([\n    \"@           $      ^       $     $        D\",\n    \"===========================================\",\n], {\n    tileWidth: 64,\n    tileHeight: 64,\n    pos: vec2(0, 200),\n    tiles: {\n        \"@\": () => [\n            sprite(\"bean\"),\n            area(),\n            body(),\n            anchor(\"bot\"),\n            \"player\",\n        ],\n        \"=\": () => [\n            sprite(\"grass\"),\n            area(),\n            body({ isStatic: true }),\n            anchor(\"bot\"),\n        ],\n        \"$\": () => [\n            sprite(\"coin\"),\n            area(),\n            anchor(\"bot\"),\n            \"coin\",\n        ],\n        \"^\": () => [\n            sprite(\"spike\"),\n            area(),\n            anchor(\"bot\"),\n            \"danger\",\n        ],\n        \"D\": () => [\n            sprite(\"door\"),\n            area(),\n            anchor(\"bot\"),\n            \"door\",\n        ],\n    },\n});\n\nconst player = level.get(\"player\")[0];\n\n// --- Movimientos ---\nonKeyPress(\"space\", () => {\n    if (player.isGrounded()) {\n        player.jump();\n    }\n});\n\nonKeyDown(\"left\", () => {\n    player.move(-SPEED, 0);\n});\n\nonKeyDown(\"right\", () => {\n    player.move(SPEED, 0);\n});\n\n// --- Colisiones ---\nplayer.onCollide(\"coin\", (coin) => {\n    destroy(coin);\n    play(\"score\");\n    score += 1;\n    scoreLabel.text = \"💰 \" + score;\n\n    // moneda se regenera\n    wait(3, () => {\n        add([\n            sprite(\"coin\"),\n            area(),\n            anchor(\"bot\"),\n            pos(coin.pos),\n            \"coin\",\n        ]);\n    });\n});\n\nplayer.onCollide(\"danger\", () => {\n    lives -= 1;\n    livesLabel.text = \"❤️ \" + lives;\n    if (lives <= 0) {\n        go(\"gameover\", { score });\n    } else {\n        player.pos = level.tile2Pos(0, 0);\n    }\n});\n\nplayer.onCollide(\"door\", () => {\n    go(\"win\", { score });\n});\n\n// --- Cámara sigue al jugador ---\nonUpdate(() => {\n    camPos(player.pos); // 👈 la cámara sigue al jugador\n});\n\n// --- Escenas ---\nscene(\"gameover\", ({ score }) => {\n    add([\n        text(\"Game Over\\nScore: \" + score, { size: 48 }),\n        pos(width() / 2, height() / 2),\n        anchor(\"center\"),\n    ]);\n});\n\nscene(\"win\", ({ score }) => {\n    add([\n        text(\"You Win!\\nScore: \" + score, { size: 48 }),\n        pos(width() / 2, height() / 2),\n        anchor(\"center\"),\n    ]);\n});\n"}]],"assets":[],"mode":"ex","kaplayVersion":"master","createdAt":"2025-08-21T16:21:56.037Z","updatedAt":"2025-08-21T16:28:23.996Z"}
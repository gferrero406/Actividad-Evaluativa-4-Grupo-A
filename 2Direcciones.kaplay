{"name":"Project #1 ","version":"2.0.0","files":[["main.js",{"path":"main.js","kind":"main","value":"kaplay({\n  background: [51, 51, 51],\n  width: 640,\n  height: 480,\n  scale: 2,\n})\n\n// velocidad definida en variable\nconst velocidad = 200\n\n// crear personaje\nloadSprite(\"github\", \"assets/sprites/github.png\");\nconst jugador = add([\n  sprite(\"github\"), \n  pos(100, 100),\n  area(),\n])\n\n\n// mover con teclas\nonUpdate(() => {\n  if (isKeyDown(\"left\")) {\n    jugador.move(-velocidad, 0)\n  }\n  if (isKeyDown(\"right\")) {\n    jugador.move(velocidad, 0)\n  }\n})\n","language":"javascript"}],["assets.js",{"path":"assets.js","kind":"assets","value":"loadSprite(\"mark\", \"assets/sprites/mark.png\");\nloadHappy();\nloadSprite(\"github\", \"assets/sprites/github.png\");\nloadSprite(\"githubb\", \"/crew/github.png\");\n","language":"javascript"}],["kaplay.js",{"path":"kaplay.js","kind":"kaplay","value":"kaplay({\n    focus: false,\n    font: \"happy\",\n    background: \"#4a3052\", \n});\n","language":"javascript"}],["scenes/game.js",{"path":"scenes/game.js","kind":"scene","value":"","language":"javascript"}],["objects/welcomeText.js",{"path":"objects/welcomeText.js","kind":"obj","value":"","language":"javascript"}]],"assets":[["assets/sprites/mark.png",{"name":"mark.png","path":"assets/sprites/mark.png","url":"data:image/png;base64,","kind":"sprite","importFunction":"loadSprite(\"mark\", \"assets/sprites/mark.png\");"}],["assets/sounds/mark_voice.wav",{"name":"mark_voice.wav","path":"assets/sounds/mark_voice.wav","url":"data:audio/wave;base64,","kind":"sound","importFunction":"loadSound(\"mark_voice\", \"assets/sounds/mark_voice.wav\");"}],["assets/sprites/github.png",{"name":"github.png","kind":"sprite","path":"assets/sprites/github.png","url":"data:image/png;base64,","importFunction":"loadSprite(\"github\", \"assets/sprites/github.png\");"}]],"mode":"pj","buildMode":"esbuild","kaplayVersion":"4000.0.0-alpha.21","createdAt":"2025-10-03T16:03:38.594Z"